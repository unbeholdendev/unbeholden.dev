---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { articleStats, day, readTime } from '../lib/entries';

interface Props {
	entries: CollectionEntry<'entries'>[];
	total: number;
}

const { entries, total } = Astro.props;
---

<ul class="callout px-5 lg:pr-8 lg:pl-0">
	{
		entries.map((entry, i) => (
			<li class="group row">
				<p class="gnum" aria-hidden="true">{total - i}</p>
				<div>
					<h2 class="font-display text-h2 font-bold text-balance">
						<a href={`/blog/${entry.id}`} class="link after:absolute after:inset-0">
							{entry.data.title}
						</a>
					</h2>
					<p class="text-dim max-w-summary mt-3 text-pretty">{entry.data.summary}</p>
					<p class="meta mt-4 text-pretty">
						{day(entry.data.date)} · {readTime(articleStats(entry).minutes)}
						{entry.data.video && ` · Video, ${entry.data.video.duration}`}
					</p>
				</div>
				<Image
					src={entry.data.poster.src}
					alt=""
					widths={[320, 640]}
					sizes="(min-width: 1024px) 288px, 100vw"
					class="border-key group-hover:border-mid -order-1 aspect-[2/1] w-full rounded border-2 object-cover lg:order-none lg:aspect-[3/2]"
				/>
			</li>
		))
	}
</ul>
