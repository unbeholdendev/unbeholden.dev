---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { articleStats, day } from '../lib/entries';

interface Props {
	entries: CollectionEntry<'entries'>[];
}

const { entries } = Astro.props;
---

<ul class="flex flex-col gap-[clamp(36px,5vw,60px)]">
	{
		entries.map((entry) => {
			const href = `/blog/${entry.id}`;
			return (
				<li class="flex flex-wrap items-start gap-x-[clamp(24px,5vw,72px)] gap-y-4">
					<div class="min-w-0 flex-1 basis-[420px]">
						<h2 class="title max-w-[660px] text-[clamp(28px,3.4vw,42px)] leading-[1.06]">
							<a href={href}>{entry.data.title}</a>
						</h2>
						<p class="text-dim mt-3 max-w-[520px] text-pretty">{entry.data.summary}</p>
						<p class="meta mt-3.5 flex flex-wrap gap-x-[22px] gap-y-2">
							<span>{day(entry.data.date)}</span>
							<a href={href} class="text-accent">
								Read · {articleStats(entry).minutes} min
							</a>
							{entry.data.video && (
								<a href={href} class="text-dim">
									Watch · {entry.data.video.duration}
								</a>
							)}
						</p>
					</div>
					<a href={href} class="block min-w-0 flex-1 basis-[240px] sm:max-w-[320px]">
						<Image
							src={entry.data.poster.src}
							alt={entry.data.poster.alt}
							widths={[320, 640, 960, 1280]}
							sizes="(min-width: 640px) 320px, 100vw"
							class="border-rule bg-bg2 aspect-video w-full border object-cover"
							loading="lazy"
						/>
					</a>
				</li>
			);
		})
	}
</ul>
