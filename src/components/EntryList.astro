---
import type { CollectionEntry } from 'astro:content';
import { articleStats, day, readTime } from '../lib/entries';

interface Props {
	entries: CollectionEntry<'entries'>[];
}

const { entries } = Astro.props;
---

<div class="border-rule border-t">
	{
		entries.map((entry) => {
			const href = `/blog/${entry.id}`;
			return (
				<article class="border-rule py-post border-b">
					<p class="meta mb-2.5">
						{day(entry.data.date)} · {readTime(articleStats(entry).minutes)}
						{entry.data.video && (
							<Fragment>
								{' · '}
								<a href={href} class="text-accent">
									Video, {entry.data.video.duration}
								</a>
							</Fragment>
						)}
					</p>
					<a href={href}>
						<h2 class="font-display text-h2 mb-3 text-balance">{entry.data.title}</h2>
					</a>
					<p class="text-dim max-w-summary text-pretty">{entry.data.summary}</p>
				</article>
			);
		})
	}
</div>
