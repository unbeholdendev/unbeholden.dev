---
import Link from './Link.astro';
import { shortDate, type Day } from '../lib/activity';

interface Props {
	id: string;
	heading: string;
	blurb: string;
	days: Day[];
}

const { id, heading, blurb, days } = Astro.props;
const hash = (url: string) => url.split('/commit/')[1]?.slice(0, 7);
const grid = 'grid gap-x-6 gap-y-1 sm:grid-cols-[11rem_1fr]';
const row = '-mx-3 px-3 py-3';
---

<section class="mt-section" aria-labelledby={id}>
	<h2 id={id} class="heading-2 scroll-mt-28">{heading}</h2>
	<p class="summary mt-3">{blurb}</p>
	<ol class="callout mt-6 px-5 lg:px-8">
		{days.map(({ date, groups }) => (
			<li class="border-key py-2 not-first:border-t-2 sm:grid sm:grid-cols-[4.5rem_1fr] sm:gap-x-6">
				<time class="meta block pt-2 sm:pt-3" datetime={date.toISOString()}>{shortDate(date)}</time>
				<ol>
					{groups.map(({ repo, items: [first, ...rest] }) => (
						<li class="border-key/20 not-first:border-t">
							{rest.length === 0 ? (
								<div class:list={[grid, row, 'relative']}>
									<span class="text-dim text-meta truncate font-mono">{repo}</span>
									<span class="text-pretty">
										{hash(first.url) && <code class="text-dim text-meta mr-2">{hash(first.url)}</code>}
										<Link href={first.url} class="link after:absolute after:inset-0">{first.title}</Link>
									</span>
								</div>
							) : (
								<details class:list={['group', row]}>
									<summary class:list={[grid, 'cursor-pointer list-none [&::-webkit-details-marker]:hidden']}>
										<span class="text-dim text-meta truncate font-mono">{repo}</span>
										<span>
											<span class="block text-pretty group-open:hidden">{first.title}</span>
											<span class="link text-meta mt-1 inline-flex items-center gap-1 group-open:mt-0">
												<span class="group-open:hidden">Show all {rest.length + 1}</span>
												<span class="hidden group-open:inline">Hide {rest.length + 1}</span>
												{hash(first.url) ? 'commits' : 'pull requests'}
												<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 transition-transform group-open:rotate-180">
													<path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
												</svg>
											</span>
										</span>
									</summary>
									<ol class="mt-3 space-y-2 sm:ml-[calc(11rem+1.5rem)]">
										{[first, ...rest].map((item) => (
											<li class="text-pretty">
												{hash(item.url) && <code class="text-dim text-meta mr-2">{hash(item.url)}</code>}
												<Link href={item.url} class="link">{item.title}</Link>
											</li>
										))}
									</ol>
								</details>
							)}
						</li>
					))}
				</ol>
			</li>
		))}
	</ol>
</section>
