---
import { getActivity } from '../lib/activity';

const lately = (await getActivity())?.lately ?? [];
const list = new Intl.ListFormat('en-GB').format(lately);
---

<p class="meta mt-6 min-h-[2lh] sm:min-h-[1lh] text-pretty">
	{lately.length > 0 && <>Lately: {list}. <a href="/work" class="underline decoration-mid decoration-2 underline-offset-3 hover:text-fg">See the work</a></>}
</p>
