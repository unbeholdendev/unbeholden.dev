<aside id="subscribe" class="min-w-0 flex-[2_1_320px]">
	<p class="font-display text-h3 mb-1.5 font-bold">New entries by email</p>
	<p class="text-dim mb-4 text-[15px] leading-[1.6] text-pretty">
		An email when I publish something, or now and then when I have something worth saying. No spam,
		and the list runs on my own server.
	</p>
	<div data-ask>
		<form
			method="post"
			action="/subscribe"
			class="flex flex-wrap gap-2"
		>
			<input
				type="email"
				name="email"
				required
				autocomplete="email"
				placeholder="you@example.org"
				aria-label="Email address"
				class="border-key bg-panel placeholder:text-faint min-w-0 flex-[1_1_220px] rounded-lg border-2 px-3 py-2 text-[15px]"
			/>
			<input type="text" name="website" hidden autocomplete="off" tabindex="-1" />
			<button type="submit" class="chip"
				>Subscribe</button
			>
		</form>
		<p class="meta mt-2">
			Double opt-in. Unsubscribe link in every email.
		</p>
	</div>
	<div data-done hidden>
		<p class="font-display text-h3 mb-1.5 font-bold">One more step</p>
		<p class="text-dim text-[15px] leading-[1.6]">
			I've sent a confirmation link to <span data-email></span>. I don't keep anything until you click it.
		</p>
	</div>
</aside>

<!-- Rerun: the swapped-in form carries no listener. -->
<script is:inline data-astro-rerun>
	(() => {
		const aside = document.getElementById('subscribe');
		const form = aside?.querySelector('form');
		if (!form) return;
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const sent = await fetch('/subscribe', { method: 'POST', body: new FormData(form) }).catch(
				() => null,
			);
			// Where the reader lands with no JavaScript, so it also says what went wrong.
			if (!sent?.ok) return form.submit();
			aside.querySelector('[data-email]').textContent = form.email.value;
			aside.querySelector('[data-ask]').hidden = true;
			aside.querySelector('[data-done]').hidden = false;
		});
	})();
</script>
