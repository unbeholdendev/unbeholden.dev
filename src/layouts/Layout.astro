---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title = 'unbeholden.dev', description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const websiteId = import.meta.env.UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/fonts/bodoni-moda-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<link
			rel="alternate"
			type="application/atom+xml"
			title="Unbeholden"
			href={new URL('/feed.xml', Astro.site)}
		/>
		<meta property="og:title" content={title} />
		<meta property="og:url" content={canonical} />
		{description && <meta name="description" content={description} />}
		{description && <meta property="og:description" content={description} />}
		{image && <meta property="og:image" content={new URL(image, Astro.site)} />}
		<script is:inline>
			if (localStorage.theme) document.documentElement.dataset.theme = localStorage.theme;
		</script>
		{
			websiteId && (
				<script is:inline defer src="/u/script.js" data-website-id={websiteId} />
			)
		}
	</head>
	<body>
		<div class="mx-auto max-w-[1360px] px-[clamp(24px,6vw,90px)]">
			<header class="flex flex-wrap gap-x-[clamp(24px,5vw,72px)] pt-[clamp(28px,5vw,64px)]">
				<div class="min-w-0 flex-1 basis-[480px]">
					<a
						href="/"
						class="font-display block text-[clamp(44px,9vw,124px)] leading-[0.86] font-medium tracking-[0.02em] uppercase"
						>Unbeholden</a
					>
					<nav class="meta mt-[clamp(20px,3vw,38px)] flex flex-wrap gap-5 tracking-[0.18em]">
						<a href="/blog/">Blog</a>
						<a href="/about">About</a>
						<a href="/feed.xml" class="text-accent">RSS</a>
						<button
							id="mode-toggle"
							type="button"
							aria-label="Switch colour mode"
							class="meta hover:text-accent cursor-pointer tracking-[0.18em]"></button>
					</nav>
				</div>
				<p class="meta min-w-0 flex-1 basis-[260px] self-end leading-[2]">
					Digital sovereignty<br />in practice
				</p>
			</header>
			<main class="py-[clamp(50px,9vw,120px)]"><slot /></main>
			<footer
				class="meta border-rule flex flex-wrap gap-5 border-t pt-5 pb-9 tracking-[0.18em]"
			>
				<a href="mailto:hello@unbeholden.dev">hello@unbeholden.dev</a>
				<a href="/feed.xml" class="text-accent">RSS</a>
			</footer>
		</div>
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const button = document.getElementById('mode-toggle');
				const dark = () =>
					root.dataset.theme
						? root.dataset.theme === 'dark'
						: !matchMedia('(prefers-color-scheme: light)').matches;
				const label = () => (button.textContent = dark() ? 'Light' : 'Dark');
				button.addEventListener('click', () => {
					root.dataset.theme = dark() ? 'light' : 'dark';
					localStorage.setItem('theme', root.dataset.theme);
					label();
				});
				label();
			})();
		</script>
	</body>
</html>
