---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'unbeholden.dev',
	description = 'Digital sovereignty, in practice. Self-hosted services, homelab and networking, Linux, and agent tooling, run on hardware I own.',
	image,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const websiteId = import.meta.env.UMAMI_WEBSITE_ID;
const here = Astro.url.pathname;
const current = (section: string) =>
	here.startsWith(section) ? 'text-fg' : 'text-faint';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/fonts/spectral-400-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<link
			rel="alternate"
			type="application/atom+xml"
			title="Unbeholden"
			href={new URL('/feed.xml', Astro.site)}
		/>
		<meta property="og:title" content={title} />
		<meta property="og:url" content={canonical} />
		<meta name="description" content={description} />
		<meta property="og:description" content={description} />
		{image && <meta property="og:image" content={new URL(image, Astro.site)} />}
		<!-- Rerun: a view transition swaps the root attributes, dropping data-theme. -->
		<script is:inline data-astro-rerun>
			if (localStorage.theme) document.documentElement.dataset.theme = localStorage.theme;
		</script>
		{
			websiteId && (
				<script is:inline defer src="/u/script.js" data-website-id={websiteId} />
			)
		}
	</head>
	<body>
		<div
			class="flex min-h-screen flex-col px-[clamp(24px,6vw,64px)] py-[clamp(28px,4vw,48px)]"
		>
			<header
				class="border-fg mx-auto flex w-full max-w-column flex-wrap items-baseline justify-between gap-x-6 gap-y-4 border-b pb-[18px]"
			>
				<div class="flex flex-col gap-[5px]">
					<a href="/" class="font-display text-wordmark uppercase">Unbeholden</a>
					<span class="meta">Digital sovereignty in practice</span>
				</div>
				<nav class="flex flex-wrap gap-x-[clamp(16px,3vw,28px)] text-nav italic">
					<a href="/blog/" class={current('/blog')}>Blog</a>
					<a href="/about" class={current('/about')}>About</a>
					<a href="/feed.xml" class="text-accent">Feed</a>
					<button
						id="mode-toggle"
						type="button"
						aria-label="Switch colour mode"
						class="text-faint hover:text-accent cursor-pointer italic"></button>
				</nav>
			</header>
			<main class="mx-auto w-full max-w-column flex-1"><slot /></main>
			<footer
				class="meta mx-auto flex w-full max-w-column flex-wrap justify-between gap-x-6 gap-y-2 pt-[clamp(64px,9vw,96px)]"
			>
				<slot name="footer">
					<span>unbeholden.dev</span>
					<span>Written and hosted on hardware I own and a VPS I pay for.</span>
				</slot>
			</footer>
		</div>
		<!-- Rerun: the swapped-in button carries no listener. -->
		<script is:inline data-astro-rerun>
			(() => {
				const root = document.documentElement;
				const button = document.getElementById('mode-toggle');
				const dark = () =>
					root.dataset.theme
						? root.dataset.theme === 'dark'
						: matchMedia('(prefers-color-scheme: dark)').matches;
				const label = () => (button.textContent = dark() ? 'Light' : 'Dark');
				button.addEventListener('click', () => {
					root.dataset.theme = dark() ? 'light' : 'dark';
					localStorage.setItem('theme', root.dataset.theme);
					label();
				});
				label();
			})();
		</script>
	</body>
</html>
