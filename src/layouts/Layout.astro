---
import { ClientRouter } from 'astro:transitions';
import Subscribe from '../components/Subscribe.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; alt: string; width: number; height: number };
	article?: { published: Date; updated?: Date };
}

// Every page shares the card unless it brings its own, so nothing is ever posted bare.
const card = {
	src: '/og.png',
	alt: 'Unbeholden: digital sovereignty in practice',
	width: 1200,
	height: 630,
};

const {
	title = 'Unbeholden · Digital sovereignty in practice',
	description = 'Digital sovereignty, in practice. Self-hosting, homelab and networking, Linux and agent tooling, on hardware I own.',
	image = card,
	article,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const social = new URL(image.src, Astro.site);
const websiteId = import.meta.env.UMAMI_WEBSITE_ID;
const here = Astro.url.pathname;
const asks = here !== '/subscribe';
const current = (section: string) =>
	here.startsWith(section) ? 'text-fg' : 'text-dim';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- Two of the twelve faces: the light display every statement and post
		     title is set in, and the body roman under all of it. -->
		<link
			rel="preload"
			href="/fonts/spectral-300-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="preload" href="/fonts/lora-latin.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<link
			rel="alternate"
			type="application/atom+xml"
			title="Unbeholden"
			href={new URL('/feed.xml', Astro.site)}
		/>
		<meta name="description" content={description} />
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:site_name" content="Unbeholden" />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:title" content={title} />
		<meta property="og:url" content={canonical} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={social} />
		<meta property="og:image:alt" content={image.alt} />
		<!-- Without the dimensions the first scrape lays the card out before the image
		     has been fetched, and renders it without one. -->
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		{
			article && (
				<>
					<meta
						property="article:published_time"
						content={article.published.toISOString()}
					/>
					{article.updated && (
						<meta
							property="article:modified_time"
							content={article.updated.toISOString()}
						/>
					)}
				</>
			)
		}
		<!-- X reads the OpenGraph tags, but without a card type it renders the small
		     one, so the image is stated again here. -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={social} />
		<meta name="twitter:image:alt" content={image.alt} />
		<!-- Rerun: a view transition swaps the root attributes, dropping data-theme. -->
		<script is:inline data-astro-rerun>
			if (localStorage.theme) document.documentElement.dataset.theme = localStorage.theme;
		</script>
		{
			websiteId && (
				<script is:inline defer src="/u/script.js" data-website-id={websiteId} />
			)
		}
	</head>
	<body>
		<div
			class="@container flex min-h-screen flex-col px-[clamp(24px,6vw,64px)] py-[clamp(28px,4vw,48px)]"
		>
			<header
				class="border-fg mx-auto flex w-full max-w-column flex-wrap items-baseline justify-between gap-x-6 gap-y-4 border-b pb-[18px]"
			>
				<div class="flex flex-col gap-[5px]">
					<a href="/" class="font-display text-wordmark uppercase">Unbeholden</a>
					<span class="meta">Digital sovereignty in practice</span>
				</div>
				<nav class="flex flex-wrap gap-x-[clamp(16px,3vw,28px)] text-nav italic">
					<a href="/blog" class={current('/blog')}>Blog</a>
					<a href="/built" class={current('/built')}>Built</a>
					<a href="/about" class={current('/about')}>About</a>
					<a href="/contact" class={current('/contact')}>Contact</a>
					<a href="/feed.xml" class="text-accent">Feed</a>
					<button
						id="mode-toggle"
						type="button"
						aria-label="Switch colour mode"
						class="text-dim hover:text-accent cursor-pointer italic"></button>
				</nav>
			</header>
			<main class="mx-auto w-full max-w-column flex-1"><slot /></main>
			<div
				class="border-fg mx-auto mt-[clamp(64px,9vw,96px)] flex w-full max-w-column flex-wrap items-start gap-x-10 gap-y-5 border-t pt-[22px]"
			>
				{asks && <Subscribe />}
				<nav aria-label="Elsewhere" class="flex-[1_1_160px]">
					<p class="meta mb-2.5">Elsewhere</p>
					<ul class="text-dim flex flex-wrap gap-4 [&_a]:block [&_a:hover]:text-accent [&_svg]:size-5">
						<li>
							<a href="https://git.unbeholden.dev/unbeholden" aria-label="Forgejo" title="Forgejo" target="_blank" rel="noopener noreferrer">
								<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.7773 0c1.6018 0 2.9004 1.2986 2.9004 2.9005s-1.2986 2.9004-2.9004 2.9004c-1.0854 0-2.0315-.596-2.5288-1.4787H12.91c-2.3322 0-4.2272 1.8718-4.2649 4.195l-.0007 2.1175a7.0759 7.0759 0 0 1 4.148-1.4205l.1176-.001 1.3385.0002c.4973-.8827 1.4434-1.4788 2.5288-1.4788 1.6018 0 2.9004 1.2986 2.9004 2.9005s-1.2986 2.9004-2.9004 2.9004c-1.0854 0-2.0315-.596-2.5288-1.4787H12.91c-2.3322 0-4.2272 1.8718-4.2649 4.195l-.0007 2.319c.8827.4973 1.4788 1.4434 1.4788 2.5287 0 1.602-1.2986 2.9005-2.9005 2.9005-1.6018 0-2.9004-1.2986-2.9004-2.9005 0-1.0853.596-2.0314 1.4788-2.5287l-.0002-9.9831c0-3.887 3.1195-7.0453 6.9915-7.108l.1176-.001h1.3385C14.7458.5962 15.692 0 16.7773 0ZM7.2227 19.9052c-.6596 0-1.1943.5347-1.1943 1.1943s.5347 1.1943 1.1943 1.1943 1.1944-.5347 1.1944-1.1943-.5348-1.1943-1.1944-1.1943Zm9.5546-10.4644c-.6596 0-1.1944.5347-1.1944 1.1943s.5348 1.1943 1.1944 1.1943c.6596 0 1.1943-.5347 1.1943-1.1943s-.5347-1.1943-1.1943-1.1943Zm0-7.7346c-.6596 0-1.1944.5347-1.1944 1.1943s.5348 1.1943 1.1944 1.1943c.6596 0 1.1943-.5347 1.1943-1.1943s-.5347-1.1943-1.1943-1.1943Z" /></svg>
							</a>
						</li>
						<li>
							<a href="https://njump.me/npub1awq28saxmfuk88je4uvecljfpeydnj7tdueu4lay8xqv6xkn0c5q69qwgl" aria-label="Nostr" title="Nostr" target="_blank" rel="noopener noreferrer">
								<svg viewBox="40 40 184 184" fill="currentColor"><path d="M210.8 199.4c0 3.1-2.5 5.7-5.7 5.7h-68c-3.1 0-5.7-2.5-5.7-5.7v-15.5c.3-19 2.3-37.2 6.5-45.5 2.5-5 6.7-7.7 11.5-9.1 9.1-2.7 24.9-.9 31.7-1.2 0 0 20.4.8 20.4-10.7s-9.1-8.6-9.1-8.6c-10 .3-17.7-.4-22.6-2.4-8.3-3.3-8.6-9.2-8.6-11.2-.4-23.1-34.5-25.9-64.5-20.1-32.8 6.2.4 53.3.4 116.1v8.4c0 3.1-2.6 5.6-5.7 5.6H57.7c-3.1 0-5.7-2.5-5.7-5.7v-144c0-3.1 2.5-5.7 5.7-5.7h31.7c3.1 0 5.7 2.5 5.7 5.7 0 4.7 5.2 7.2 9 4.5 11.4-8.2 26-12.5 42.4-12.5 36.6 0 64.4 21.4 64.4 68.7v83.2ZM150 99.3c0-6.7-5.4-12.1-12.1-12.1s-12.1 5.4-12.1 12.1 5.4 12.1 12.1 12.1S150 106 150 99.3Z" /></svg>
							</a>
						</li>
						<li>
							<a href="https://x.com/unbeholdendev" aria-label="X" title="X" target="_blank" rel="noopener noreferrer">
								<svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" /></svg>
							</a>
						</li>
						<li>
							<a href="lightning:jakub@unbeholden.dev" aria-label="Lightning: jakub@unbeholden.dev" title="jakub@unbeholden.dev">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z" /></svg>
							</a>
						</li>
						<li>
							<a href="/feed.xml" aria-label="Feed" title="Feed">
								<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z" /></svg>
							</a>
						</li>
						<li>
							<a href="mailto:hello@unbeholden.dev" aria-label="Email: hello@unbeholden.dev" title="hello@unbeholden.dev">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg>
							</a>
						</li>
					</ul>
				</nav>
			</div>
			<footer
				class="meta mx-auto flex w-full max-w-column flex-wrap justify-between gap-x-6 gap-y-2 pt-7"
			>
				<slot name="footer">
					<span>unbeholden.dev</span>
					<span>Hosted on my own hardware and a rented VPS.</span>
				</slot>
			</footer>
		</div>
		<!-- Rerun: the swapped-in button carries no listener. -->
		<script is:inline data-astro-rerun>
			(() => {
				const root = document.documentElement;
				const button = document.getElementById('mode-toggle');
				const dark = () =>
					root.dataset.theme
						? root.dataset.theme === 'dark'
						: matchMedia('(prefers-color-scheme: dark)').matches;
				const label = () => (button.textContent = dark() ? 'Light' : 'Dark');
				button.addEventListener('click', () => {
					root.dataset.theme = dark() ? 'light' : 'dark';
					localStorage.setItem('theme', root.dataset.theme);
					label();
				});
				label();
			})();
		</script>
	</body>
</html>
