---
import Head from '../components/Head.astro';
import HiringBanner from '../components/HiringBanner.astro';
import Masthead from '../components/Masthead.astro';
import Subscribe from '../components/Subscribe.astro';
import Elsewhere from '../components/Elsewhere.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; alt: string; width: number; height: number };
	article?: { published: Date; updated?: Date };
	profile?: boolean;
}

// Every page shares the card unless it brings its own, so nothing is ever posted bare.
const card = {
	src: '/og.png',
	alt: 'Unbeholden: software, and the infrastructure behind it',
	width: 1200,
	height: 630,
};

const {
	title,
	description = `${site.tagline}. Self-hosting, homelab and networking, Linux and agent tooling, on hardware I own.`,
	image = card,
	article,
	profile = false,
} = Astro.props;
const offerSubscription = Astro.url.pathname !== '/subscribe';
---

<!doctype html>
<html lang="en">
	<head>
		<Head
			title={title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`}
			{description}
			{image}
			{article}
			{profile}
		/>
	</head>
	<body>
		<a href="#main" class="chip fixed top-3 left-3 z-20 -translate-y-24 focus:translate-y-0">Skip to content</a>
		<HiringBanner />
		<div class="mx-auto flex min-h-screen max-w-page flex-col px-4 pt-8 pb-12 sm:px-10 sm:pt-12">
			<Masthead />
			<main id="main" class="flex-1"><slot /></main>
			<div class="border-key mt-20 flex flex-wrap items-start gap-x-10 gap-y-6 border-t-2 pt-8">
				{offerSubscription && <Subscribe />}
				<Elsewhere />
			</div>
			<Footer />
		</div>
	</body>
</html>
