---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title = 'unbeholden.dev', description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link
			rel="preload"
			href="/fonts/bodoni-moda-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:url" content={canonical} />
		{description && <meta name="description" content={description} />}
		{description && <meta property="og:description" content={description} />}
		{image && <meta property="og:image" content={new URL(image, Astro.site)} />}
		<script is:inline>
			if (localStorage.theme) document.documentElement.dataset.theme = localStorage.theme;
		</script>
	</head>
	<body>
		<div class="mx-auto max-w-[1360px] px-[clamp(24px,6vw,90px)]">
			<header class="pt-[clamp(28px,5vw,64px)]">
				<div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
					<a
						href="/"
						class="font-display text-[clamp(40px,9vw,124px)] leading-[0.92] font-medium tracking-[0.02em] uppercase"
						>Unbeholden</a
					>
					<p class="meta text-right leading-[1.9]">
						Digital sovereignty, in practice<br />unbeholden.dev
					</p>
				</div>
				<nav
					class="meta border-rule mt-[clamp(20px,3vw,36px)] flex items-center justify-between gap-6 border-t pt-3"
				>
					<p>
						<a href="/blog/">Blog</a> · <a href="/about">About</a> · <a href="/feed.xml">RSS</a>
					</p>
					<button
						id="mode-toggle"
						type="button"
						aria-label="Switch colour mode"
						class="hover:text-accent -my-2 cursor-pointer p-2"
					>
						<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
							<circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
							<path d="M8 0.75a7.25 7.25 0 0 0 0 14.5z" fill="currentColor" />
						</svg>
					</button>
				</nav>
			</header>
			<main class="pt-[clamp(40px,6vw,80px)]"><slot /></main>
			<footer
				class="meta border-rule mt-[clamp(56px,9vw,120px)] flex flex-wrap justify-between gap-x-10 gap-y-3 border-t py-8 leading-[1.9]"
			>
				<p>© {year} Unbeholden</p>
				<p>Prose CC BY 4.0 · Code CC0/MIT</p>
				<p>
					<a href="mailto:hello@unbeholden.dev">Email</a> · <a
						href="https://git.home.unbeholden.dev/unbeholden">Forgejo</a
					>
				</p>
			</footer>
		</div>
		<script is:inline>
			document.getElementById('mode-toggle').addEventListener('click', () => {
				const root = document.documentElement;
				const dark = root.dataset.theme
					? root.dataset.theme === 'dark'
					: !matchMedia('(prefers-color-scheme: light)').matches;
				root.dataset.theme = dark ? 'light' : 'dark';
				localStorage.setItem('theme', root.dataset.theme);
			});
		</script>
	</body>
</html>
