---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found · Unbeholden" description="Nothing lives at this address.">
	<h1 class="font-display text-statement mt-masthead max-w-statement font-extrabold text-balance">
		Nothing lives at this address.
	</h1>
	<p class="text-dim text-lede max-w-lede mt-6">
		It may have moved, or it may never have existed.
	</p>
	<p class="mt-8 flex flex-wrap gap-2">
		<a href="/blog" class="chip no-underline">Read the blog</a>
		<a href="/" class="chip no-underline">Back to the front page</a>
	</p>
</Layout>
