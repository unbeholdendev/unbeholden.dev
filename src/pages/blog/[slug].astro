---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { listEntries, articleStats, day, readTime } from '../../lib/entries';

export async function getStaticPaths() {
	const entries = await listEntries();
	return entries.map((entry, i) => ({
		params: { slug: entry.id },
		props: { entry, n: entries.length - i, newer: entries[i - 1], older: entries[i + 1] },
	}));
}

const { entry, n, newer, older } = Astro.props;
const { title, date, summary, topic, poster, video, updated } = entry.data;
const { Content } = await render(entry);
const { minutes } = articleStats(entry);

// 1.91:1, the ratio every card is laid out at, cropped from the 16:9 poster.
const social = await getImage({ src: poster.src, format: 'jpg', width: 1200, height: 630 });
const PosterFrame = video ? 'a' : 'div';
const watch = video && `https://www.youtube.com/watch?v=${video.id}`;
---

<Layout
	{title}
	description={summary}
	image={{ src: social.src, alt: poster.alt, width: 1200, height: 630 }}
	article={{ published: date, updated }}
>
	<article
		class="callout text-article mt-12 px-5 pt-6 pb-12 [--gap:40px] [--gutter:176px] lg:grid lg:grid-cols-[var(--gutter)_min(600px,100%)] lg:justify-center lg:gap-x-(--gap) lg:px-12 lg:pt-14 lg:pb-20"
		style={`--n: "${n}."`}
	>
		<p class="entry-number mb-4 lg:mb-0" aria-hidden="true">{n}</p>
		<header class="min-w-0">
			<h1 class="font-display text-h1 font-extrabold text-balance">{title}</h1>
			<p class="standfirst mt-6">{summary}</p>
			<p class="meta mt-5 text-pretty">
				{topic} · {day(date)} · {readTime(minutes)}
				{updated && ` · Updated ${day(updated)}`}
				{watch && (
					<Fragment>
						{' · '}
						<a href={watch} class="link">Video, {video.duration}</a>
					</Fragment>
				)}
			</p>
		</header>

		<figure class="mt-10 min-w-0 lg:col-start-2">
			<PosterFrame href={watch} class="block">
				<Image
					src={poster.src}
					alt={poster.alt}
					widths={[720, 1440]}
					sizes="(min-width: 1024px) 680px, 100vw"
					class="border-key bg-bg2 aspect-video w-full rounded border-2 object-cover"
				/>
			</PosterFrame>
		</figure>

		<div class="article mt-12 min-w-0 lg:col-start-2"><Content /></div>
	</article>

	<nav aria-label="Other entries" class="mt-10 grid gap-x-10 gap-y-6 md:grid-cols-2">
		{
			older ? (
				<a href={`/blog/${older.id}`} class="border-key grid gap-2 border-t-2 pt-4">
					<span class="meta">← Older</span>
					<span class="heading-3 link">{older.data.title}</span>
				</a>
			) : (
				<span />
			)
		}
		{
			newer && (
				<a href={`/blog/${newer.id}`} class="border-key grid gap-2 border-t-2 pt-4 text-right">
					<span class="meta">Newer →</span>
					<span class="heading-3 link">{newer.data.title}</span>
				</a>
			)
		}
	</nav>
</Layout>
