---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { listEntries, articleStats, day, readTime } from '../../lib/entries';

export async function getStaticPaths() {
	const entries = await listEntries();
	return entries.map((entry, i) => ({
		params: { slug: entry.id },
		props: { entry, older: entries[i + 1] },
	}));
}

const { entry, older } = Astro.props;
const { title, date, summary, topic, poster, video } = entry.data;
const { Content } = await render(entry);
const { minutes } = articleStats(entry);

const social = await getImage({ src: poster.src, format: 'jpg', width: 1200, height: 675 });
const PosterFrame = video ? 'a' : 'div';
---

<Layout title={`${title} · Unbeholden`} description={summary} image={social.src}>
	<article class="text-article">
		<header class="mt-masthead mb-[60px] text-center">
			<p class="meta mb-5">{topic} · {day(date)} · {readTime(minutes)}</p>
			<h1 class="font-display text-h1 mb-[22px] font-light text-balance">{title}</h1>
			<p class="font-display text-lede text-dim max-w-lede mx-auto font-light text-pretty">
				{summary}
			</p>
			{
				video && (
					<p class="text-nav mt-[26px] italic">
						<a href={`https://www.youtube.com/watch?v=${video.id}`} class="text-accent">
							Watch the video, {video.duration} →
						</a>
					</p>
				)
			}
			<div class="bg-fg mx-auto mt-10 h-px w-10"></div>
		</header>

		<figure class="mb-12">
			<PosterFrame
				href={video && `https://www.youtube.com/watch?v=${video.id}`}
				class="border-rule block border"
			>
				<Image
					src={poster.src}
					alt={poster.alt}
					widths={[820, 1640]}
					sizes="820px"
					class="bg-bg2 aspect-video w-full object-cover"
				/>
			</PosterFrame>
		</figure>

		<div class="article"><Content /></div>
	</article>

	<Fragment slot="footer">
		{older ? <a href={`/blog/${older.id}`}>← {older.data.title}</a> : <span />}
		<a href="/blog/">All entries →</a>
	</Fragment>
</Layout>
