---
import EntryList from '../../components/EntryList.astro';
import Layout from '../../layouts/Layout.astro';
import { listEntries } from '../../lib/entries';

const entries = await listEntries();
---

<Layout
	title="Blog · Unbeholden"
	description="Everything I've written about self-hosting, homelab and networking, Linux, agent tooling, and the small bits of config that make daily work less annoying."
>
	<p class="meta mt-masthead">
		Newest first, in full at <a href="/feed.xml" class="text-accent">feed.xml</a>
	</p>
	<div class="mt-7">
		<EntryList entries={entries} />
	</div>
</Layout>
