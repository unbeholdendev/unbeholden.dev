---
import EntryList from '../../components/EntryList.astro';
import Layout from '../../layouts/Layout.astro';
import { listEntries } from '../../lib/entries';

const entries = await listEntries();
---

<Layout
	title="Blog"
	description="Everything I've written about self-hosting, homelab and networking, Linux, agent tooling, and the small bits of config that make daily work less annoying."
>
	<h1 class="page-title">
		Everything I've written.
	</h1>
	<p class="meta mt-4">
		Newest first. Full text in the <a href="/feed.xml" class="link">feed</a>.
	</p>
	<div class="mt-section">
		<EntryList entries={entries} total={entries.length} />
	</div>
</Layout>
