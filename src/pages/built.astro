---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const things: { name: string; description: string; link?: string; code?: string }[] = [
	{
		name: 'AI PR reviewer',
		description:
			'A code review bot for Forgejo. It reviews pull requests with Claude Code and answers questions in the comments.',
		code: 'https://git.unbeholden.dev/unbeholden/reviewer',
	},
	{
		name: 'Unbeholden',
		description: 'This site. Astro, served from my own hardware and a rented VPS.',
		link: 'https://unbeholden.dev',
	},
	{
		name: 'Skorpik',
		description: 'An office prediction league on real matches. No money, no stakes, no odds.',
		link: 'https://skorpik.app',
	},
	{
		name: 'lnurl-server',
		description:
			'A small Lightning Address server in Go. Payments to you@yourdomain are invoiced by your own LND node.',
		code: 'https://git.unbeholden.dev/unbeholden/lnurl-server',
	},
];

// Committed, not fetched at build, per ADR-0001. Add one with `bun scripts/og-image.ts <link>`.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/built/*', { eager: true });
const image = (link?: string) =>
	link &&
	Object.entries(images).find(([path]) => path.includes(`/${new URL(link).hostname}.`))?.[1]
		.default;
---

<Layout
	title="Built · Unbeholden"
	description="Things I've built, with a link and the source where it's public."
>
	<h1 class="font-display text-statement mt-masthead max-w-statement font-extrabold text-balance">
		Things I've built.
	</h1>
	<ul class="callout mt-section px-5 lg:px-8">
		{
			things.map((thing) => {
				const src = image(thing.link);
				const away = (href: string) =>
					new URL(href).hostname === Astro.site?.hostname ? {} : { target: '_blank', rel: 'noopener noreferrer' };
				return (
					<li class="row lg:grid-cols-[1fr_288px] lg:bg-left-top">
						<div class:list={{ 'lg:col-span-2': !src }}>
							<h2 class="font-display text-h2 font-bold">{thing.name}</h2>
							<p class="text-dim max-w-summary mt-3 text-pretty">{thing.description}</p>
							<p class="mt-4 flex flex-wrap gap-2">
								{thing.link && <a href={thing.link} {...away(thing.link)} class="chip no-underline">{new URL(thing.link).hostname}</a>}
								{thing.code && <a href={thing.code} {...away(thing.code)} class="chip no-underline">Source</a>}
							</p>
						</div>
						{src && (
							/* Empty alt: the row repeats the name and description beside it. Add one if it says more. */
							<Image
								src={src}
								alt=""
								widths={[320, 640]}
								sizes="(min-width: 1024px) 288px, 100vw"
								class="border-key -order-1 aspect-[40/21] w-full rounded-lg border-2 object-cover lg:order-none"
							/>
						)}
					</li>
				);
			})
		}
	</ul>
</Layout>
