---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { site } from '../data/site';
import { MAX_MESSAGE, sendContact } from '../lib/forms';
import { rateLimit } from '../lib/rate-limit';
import { push } from '../lib/ntfy';

export const prerender = false;

const { state, name, email, message } =
	Astro.request.method === 'POST'
		? await sendContact(await Astro.request.formData(), rateLimit, push)
		: ({ state: 'form', name: '', email: '', message: '' } as const);

if (state === 'failed') Astro.response.status = 400;
if (state === 'limited') Astro.response.status = 429;

const copy = {
	form: {
		heading: 'Write to me.',
		lede: "A question about an entry, a correction, something you built, or a role you're hiring for. It comes straight to my phone, through a server I run.",
	},
	failed: {
		heading: "That didn't go through.",
		lede: "It didn't arrive. Your message is still below, so try again, or send an email instead.",
	},
	limited: {
		heading: 'Too many messages right now.',
		lede: 'The form takes ten messages an hour, and this hour is full. Try again later, or send an email instead.',
	},
};
---

<Layout title="Contact" description="Write to me.">
	{
		state === 'sent' ? (
			<Fragment>
				<h1 class="page-title">
					Got it.
				</h1>
				<p class="lede mt-6">
					It's on my phone. If you left a way to reach you, I'll reply there.
				</p>
				<p class="mt-8">
					<a href="/" class="chip">Back to the front page</a>
				</p>
			</Fragment>
		) : (
			<Fragment>
				<h1 class="page-title">
					{copy[state].heading}
				</h1>
				<p class="lede mt-6">
					{copy[state].lede}
				</p>
				<p class="text-dim text-lede max-w-lede mt-4">
					Rather talk? <Link href="https://cal.unbeholden.dev/u/jakub/lets-chat" class="link">Book a half-hour call</Link>.
				</p>
				<form method="post" action="/contact" class="callout mt-section flex max-w-[720px] flex-col gap-8 p-5 sm:p-8">
					<label class="flex flex-col gap-2">
						<span class="meta">Name (optional)</span>
						<input type="text" name="name" autocomplete="name" maxlength="100" value={name} class="field w-full" />
					</label>
					<label class="flex flex-col gap-2">
						<span class="meta">Email (optional)</span>
						<input
							type="email"
							name="email"
							maxlength="254"
							autocomplete="email"
							placeholder="you@example.org"
							value={email}
							class="field w-full"
						/>
						<span class="meta">
							Fill this in if you'd like a reply, or put another way to reach you in the message.
						</span>
					</label>
					<label class="flex flex-col gap-2">
						<span class="meta">Message</span>
						<textarea name="message" required maxlength={MAX_MESSAGE} rows="8" class="field w-full resize-y"
							>{message}</textarea
						>
					</label>
					<input type="text" name="website" hidden autocomplete="off" tabindex="-1" />
					<div class="flex flex-col items-end gap-2">
						<button type="submit" class="chip">Send</button>
						<span class="meta">
							Or write to <a href={`mailto:${site.email}`} class="link">{site.email}</a>
						</span>
					</div>
				</form>
			</Fragment>
		)
	}
</Layout>
