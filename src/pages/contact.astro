---
import Layout from '../layouts/Layout.astro';
import { rateLimit } from '../lib/rate-limit';
import { push } from '../lib/ntfy';

export const prerender = false;

const MAX = 3500;

// ntfy caps a message at 4096 bytes, and 3500 characters outside ASCII can pass that. The
// log holds every message whole, so the push can be cut short.
function fit(text: string) {
	const bytes = new TextEncoder().encode(text);
	if (bytes.length <= 3700) return text;
	const cut = new TextDecoder().decode(bytes.slice(0, 3700)).replace(/\uFFFD$/, '');
	return `${cut}\n\n[Cut short. The whole message is in the server log.]`;
}

let state: 'form' | 'sent' | 'failed' | 'limited' = 'form';
let name = '';
let email = '';
let message = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	name = String(form.get('name') ?? '').trim().slice(0, 100);
	email = String(form.get('email') ?? '').trim().slice(0, 254);
	message = String(form.get('message') ?? '').trim();

	// A bot fills the hidden field. Tell it yes and send nothing.
	if (String(form.get('website') ?? '') !== '') state = 'sent';
	else if (!message || message.length > MAX) state = 'failed';
	else {
		const admitted = rateLimit();
		console.log(JSON.stringify({ contact: { name, email, message, admitted } }));
		if (admitted === 'first-over') {
			void push({
				title: 'Contact form rate-limited',
				message: 'Ten messages this hour. The rest are in the server log.',
				tags: ['warning'],
			});
		}
		if (admitted !== 'ok') state = 'limited';
		else {
			const replyable = /^[^\s@?&]+@[^\s@?&]+$/.test(email);
			const sent = await push({
				title: name ? `Message from ${name}` : 'Message',
				message: email ? `${fit(message)}\n\n${email}` : fit(message),
				tags: ['speech_balloon'],
				actions: replyable
					? [
							{
								action: 'view',
								label: 'Reply',
								url: `mailto:${email}?subject=${encodeURIComponent('Your message on unbeholden.dev')}`,
							},
						]
					: undefined,
			});
			state = sent ? 'sent' : 'failed';
		}
	}
}

if (state === 'failed') Astro.response.status = 400;
if (state === 'limited') Astro.response.status = 429;

const field =
	'border-key bg-panel placeholder:text-faint w-full rounded-lg border-2 px-3 py-2';
---

<Layout title="Contact · Unbeholden" description="Write to me.">
	{
		state === 'sent' ? (
			<Fragment>
				<h1 class="font-display text-statement mt-masthead max-w-statement font-extrabold text-pretty">
					Got it.
				</h1>
				<p class="text-dim text-lede max-w-lede mt-6 text-pretty">
					It's on my phone. If you left a way to reach you, I'll reply there.
				</p>
				<p class="mt-8">
					<a href="/" class="chip no-underline">Back to the front page</a>
				</p>
			</Fragment>
		) : (
			<Fragment>
				<h1 class="font-display text-statement mt-masthead max-w-statement font-extrabold text-pretty">
					{state === 'failed'
						? "That didn't go through."
						: state === 'limited'
							? 'Too many messages right now.'
							: 'Write to me.'}
				</h1>
				<p class="text-dim text-lede max-w-lede mt-6 text-pretty">
					{state === 'failed'
						? "It didn't reach my phone. Your message is still below, so try again, or send it from your own mail."
						: state === 'limited'
							? 'The form takes ten an hour and this one is full. Try again later, or send it from your own mail.'
							: 'A question about an entry, a correction, something you built. It comes straight to my phone, through my own server.'}
				</p>
				<p class="text-dim text-lede max-w-lede mt-4">
					Rather talk? <a href="https://cal.unbeholden.dev/u/jakub/lets-chat" target="_blank" rel="noopener noreferrer" class="link">Book a half-hour call</a>.
				</p>
				<form method="post" action="/contact" class="callout mt-section flex max-w-[720px] flex-col gap-8 p-5 sm:p-8">
					<label class="flex flex-col gap-2">
						<span class="meta">Name (optional)</span>
						<input type="text" name="name" autocomplete="name" maxlength="100" value={name} class={field} />
					</label>
					<label class="flex flex-col gap-2">
						<span class="meta">Email (optional)</span>
						<input
							type="email"
							name="email"
							maxlength="254"
							autocomplete="email"
							placeholder="you@example.org"
							value={email}
							class={field}
						/>
						<span class="meta">
							Fill this in if you'd like a reply, or put another way to reach you in the message.
						</span>
					</label>
					<label class="flex flex-col gap-2">
						<span class="meta">Message</span>
						<textarea name="message" required maxlength={MAX} rows="8" class={`${field} resize-y`}
							>{message}</textarea
						>
					</label>
					<input type="text" name="website" hidden autocomplete="off" tabindex="-1" />
					<div class="flex flex-col items-end gap-2">
						<button type="submit" class="chip">Send</button>
						<span class="meta">
							Or write to <a href="mailto:hello@unbeholden.dev" class="link">hello@unbeholden.dev</a>
						</span>
					</div>
				</form>
			</Fragment>
		)
	}
</Layout>
