---
import EntryList from '../components/EntryList.astro';
import Layout from '../layouts/Layout.astro';
import { listEntries } from '../lib/entries';

const latest = (await listEntries()).slice(0, 3);
---

<Layout>
	<p class="text-dim max-w-[620px] text-[19px] leading-[1.8]">
		Self-hosted infrastructure, homelab and networking, Linux, agent tooling, and the small
		configurations that make daily work less annoying. Every system written about here runs in my
		own rack or on a VPS I pay for.
	</p>
	<div class="mt-[clamp(40px,6vw,80px)]">
		<EntryList entries={latest} />
	</div>
</Layout>
