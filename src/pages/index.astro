---
import EntryList from '../components/EntryList.astro';
import Layout from '../layouts/Layout.astro';
import { listEntries } from '../lib/entries';

const latest = (await listEntries()).slice(0, 3);
---

<Layout>
	<p class="max-w-[480px] text-[20px] leading-[1.75] text-pretty">
		A rack in the corner of the room, a VPS I pay for, and no third parties in between. Self-hosted
		services, homelab and networking, Linux, agent tooling, and the small configurations that make
		daily work less annoying. When the tool I need doesn't exist, I build it and publish it.
	</p>
	<div class="mt-[clamp(50px,9vw,120px)]">
		<EntryList entries={latest} />
	</div>
</Layout>
