---
import EntryList from '../components/EntryList.astro';
import Layout from '../layouts/Layout.astro';
import { listEntries } from '../lib/entries';

const latest = (await listEntries()).slice(0, 3);
---

<Layout>
	<p class="font-display text-statement mt-masthead max-w-statement font-light text-pretty">
		A shelf of hardware, a rented VPS, and no third parties in between.
	</p>
	<p class="text-dim max-w-lede mt-[26px] text-pretty">
		I write about self-hosting, my homelab and network, Linux, agent tooling, and the small bits
		of config that make daily work less annoying. When the tool I need doesn't exist, I build it
		and put it here.
	</p>
	<div class="mt-section [&_h2]:text-h3">
		<p class="meta mb-3">Latest entries</p>
		<EntryList entries={latest} />
		<p class="text-nav mt-7 italic">
			<a href="/blog" class="text-accent">All entries →</a>
		</p>
	</div>
</Layout>
