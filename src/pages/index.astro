---
import EntryList from '../components/EntryList.astro';
import Layout from '../layouts/Layout.astro';
import { listEntries } from '../lib/entries';

const latest = (await listEntries()).slice(0, 3);
---

<Layout>
	<p class="font-display text-statement mt-masthead max-w-statement font-light text-pretty">
		A shelf of hardware, a VPS I pay for, and no third parties in between.
	</p>
	<p class="text-dim max-w-lede text-small mt-[26px] text-pretty">
		Self-hosted services, homelab and networking, Linux, agent tooling, and the small
		configurations that make daily work less annoying. When the tool I need doesn't exist, I build
		it and publish it.
	</p>
	<div class="mt-section">
		<EntryList entries={latest} />
		<p class="text-nav mt-7 italic">
			<a href="/blog/" class="text-accent">All entries →</a>
		</p>
	</div>
</Layout>
