---
import EntryList from '../components/EntryList.astro';
import Lately from '../components/Lately.astro';
import Layout from '../layouts/Layout.astro';
import { listEntries } from '../lib/entries';

const entries = await listEntries();
---

<Layout>
	<h1 class="page-title">
		I run the services I depend on, on a shelf of hardware and a rented&nbsp;VPS.
	</h1>
	<p class="lede mt-6">
		I write about self-hosting, homelab and networking, Linux, agent tooling, and the small bits
		of config that make daily work less annoying.
	</p>
	<Lately server:defer>
		<p slot="fallback" class="meta mt-6 min-h-[2lh] sm:min-h-[1lh]"></p>
	</Lately>
	<div class="mt-section">
		<EntryList entries={entries.slice(0, 3)} total={entries.length} />
		{entries.length > 3 && <p class="mt-6"><a href="/blog" class="chip">All entries</a></p>}
	</div>
</Layout>
