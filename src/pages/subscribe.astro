---
import Layout from '../layouts/Layout.astro';
import { subscribe } from '../lib/forms';
import { push } from '../lib/ntfy';

export const prerender = false;

if (Astro.request.method !== 'POST') return Astro.redirect('/', 303);

const { ok, email } = await subscribe(await Astro.request.formData(), push);

if (!ok) Astro.response.status = 400;
---

<Layout title="Subscribe · Unbeholden" description="An email when I publish.">
	{
		ok ? (
			<Fragment>
				<h1 class="font-display text-statement mt-masthead max-w-statement font-extrabold text-pretty">
					Check your inbox.
				</h1>
				<p class="text-dim text-lede max-w-lede mt-6 text-pretty">
					I've sent a confirmation link to {email}. Nothing gets mailed to you until you click it.
				</p>
			</Fragment>
		) : (
			<Fragment>
				<h1 class="font-display text-statement mt-masthead max-w-statement font-extrabold text-pretty">
					That didn't go through.
				</h1>
				<p class="text-dim text-lede max-w-lede mt-6 text-pretty">
					Nothing was sent or saved. Try again, or write to
					<a href="mailto:hello@unbeholden.dev" class="link">hello@unbeholden.dev</a> and I'll
					add you by hand.
				</p>
			</Fragment>
		)
	}
	<p class="mt-8">
		<a href="/" class="chip">Back to the front page</a>
	</p>
</Layout>
