---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import GitHub from '../assets/github.svg';
import Feed from '../components/Feed.astro';
import Link from '../components/Link.astro';
import { projects, screenshot } from '../data/projects';
import { byDay, getActivity, shortDate } from '../lib/activity';

export const prerender = false;

const activity = await getActivity();
const ordered = projects
	.map((project) => ({ ...project, updated: project.code ? activity?.latest(project.code) : undefined }))
	.sort((a, b) => (b.updated?.getTime() ?? 0) - (a.updated?.getTime() ?? 0));
const pulls = byDay(activity?.pulls ?? []);
const days = activity?.days ?? [];
---

<Layout
	title="Work"
	description="What I build, with links and source where public, plus my open source contributions and recent commits on GitHub."
>
	<h1 class="page-title">
		What I build.
	</h1>
	<p class="meta mt-6 text-pretty">
		{pulls.length > 0 && <><a href="#contributions" class="link">Open source contributions</a>{' · '}</>}
		<a href="#projects" class="link">Projects</a>
		{days.length > 0 && <>{' · '}<a href="#recently" class="link">Recent commits</a></>}
	</p>
	{pulls.length > 0 && <Feed id="contributions" heading="Open source contributions" blurb="Pull requests to other people's projects on GitHub." days={pulls} />}
	<h2 id="projects" class="heading-2 mt-section scroll-mt-28">Projects</h2>
	<ul class="callout mt-6 px-5 lg:px-8">
		{
			ordered.map((project) => {
				const href = project.link === undefined ? project.code : project.link;
				const src = screenshot(href);
				return (
					<li class="row">
						<div>
							<h3 class="heading-2 text-balance">
								<Link href={href} class="link">
									{project.name}
								</Link>
							</h3>
							<p class="summary mt-3">{project.description}</p>
							<p class="text-dim text-meta mt-3 font-mono text-pretty">{project.stack.join(' · ')}</p>
							{project.code && (project.link || project.updated) && (
								<p class="meta mt-1 flex flex-wrap gap-x-3 gap-y-1">
									{project.link && <Link href={project.code} class="link">Source</Link>}
									{project.updated && (
										<Link href={`${project.code}/commits`} class="link">Updated {shortDate(project.updated)}</Link>
									)}
								</p>
							)}
						</div>
						{src ? (
							/* Empty alt: the row repeats the name and description beside it. Add one if it says more. */
							<Image
								src={src}
								alt=""
								widths={[320, 640]}
								sizes="(min-width: 1024px) 288px, 100vw"
								class="border-key -order-1 aspect-[40/21] w-full rounded border-2 object-cover lg:order-none"
							/>
						) : (
							<div class="border-key -order-1 grid aspect-[40/21] w-full place-items-center rounded border-2 lg:order-none">
								<GitHub aria-hidden="true" class="text-dim h-1/2 w-auto" />
							</div>
						)}
					</li>
				);
			})
		}
	</ul>
	{days.length > 0 && <Feed id="recently" heading="Recently" blurb="Public commits on GitHub from the last 14 days." days={days} />}
</Layout>
